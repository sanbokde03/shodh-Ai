{
  "schema_version": "1.0",
  "id": "v3_d",
  "revision": 28,
  "fields": {
    "category": {
      "type": "enum",
      "values": [
        "billing",
        "technical",
        "research"
      ]
    },
    "urgent": {
      "type": "boolean"
    },
    "waiting": {
      "type": "number",
      "unit": "minutes"
    }
  },
  "requirements": [
    {
      "id": "policy_25524_3",
      "order": 3,
      "version": 1,
      "location": "policy/paragraph/4",
      "text": "OTHERWISE THEN normal"
    },
    {
      "id": "policy_20125_1",
      "order": 1,
      "version": 1,
      "location": "policy/paragraph/2",
      "text": "IF urgent = true THEN priority"
    },
    {
      "id": "policy_21467_2",
      "order": 2,
      "version": 1,
      "location": "policy/paragraph/3",
      "text": "WHEN waiting >= 45 minutes THEN escalation"
    },
    {
      "id": "policy_90633_0",
      "order": 0,
      "version": 1,
      "location": "policy/paragraph/1",
      "text": "IF category IS MISSING THEN manual"
    }
  ],
  "specification": {
    "version": 5,
    "rules": [
      {
        "id": "S1",
        "rule_ref": "policy_90633_0",
        "order": 0,
        "when": {
          "field": "category",
          "op": "missing"
        },
        "route": "manual"
      },
      {
        "id": "S2",
        "rule_ref": "policy_20125_1",
        "order": 1,
        "when": {
          "field": "urgent",
          "op": "eq",
          "value": true
        },
        "route": "priority"
      },
      {
        "id": "S3",
        "rule_ref": "policy_21467_2",
        "order": 2,
        "when": {
          "field": "waiting",
          "op": "gte",
          "value": 45,
          "unit": "minutes"
        },
        "route": "escalation"
      },
      {
        "id": "S4",
        "rule_ref": "policy_25524_3",
        "order": 3,
        "when": true,
        "route": "normal"
      }
    ]
  },
  "workflow": {
    "version": 11,
    "entry": "n1",
    "nodes": [
      {
        "id": "n1",
        "kind": "decision",
        "rule_ref": "policy_90633_0",
        "when": {
          "field": "category",
          "op": "missing"
        },
        "true": "out_manual",
        "false": "n2",
        "snippet_id": "main"
      },
      {
        "id": "n2",
        "kind": "decision",
        "rule_ref": "policy_20125_1",
        "when": {
          "field": "urgent",
          "op": "eq",
          "value": true
        },
        "true": "out_priority",
        "false": "n3"
      },
      {
        "id": "n3",
        "kind": "decision",
        "rule_ref": "policy_21467_2",
        "when": {
          "field": "waiting",
          "op": "gte",
          "value": 45,
          "unit": "minutes"
        },
        "true": "out_escalation",
        "false": "out_normal"
      },
      {
        "id": "out_manual",
        "kind": "route",
        "route": "manual"
      },
      {
        "id": "out_priority",
        "kind": "route",
        "route": "priority"
      },
      {
        "id": "out_escalation",
        "kind": "route",
        "route": "escalation"
      },
      {
        "id": "out_normal",
        "kind": "route",
        "route": "normal"
      }
    ]
  },
  "snippets": [
    {
      "id": "main",
      "version": 5,
      "code": "def route(ticket):\n    if ticket.get(\"category\") is None:\n        return \"manual\"\n    if ticket[\"urgent\"] == True:\n        return \"priority\"\n    if ticket.get(\"waiting\") is not None and ticket.get(\"waiting\") >= 45:\n        return \"escalation\"\n    return \"normal\"\n"
    }
  ],
  "approvals": []
}
